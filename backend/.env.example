# IBM watsonx.ai (test mode with IBM Granite)
WATSONX_APIKEY=your_key_here
WATSONX_PROJECT_ID=your_project_id
WATSONX_URL=https://eu-de.ml.cloud.ibm.com


# watsonx.ai model to use (optional; this is the default value)
# It must exist in your region. In eu-de (Frankfurt), the available Granite chat model
# is ibm/granite-4-h-small. List yours with get_chat_model_specs().
WATSONX_MODEL_ID=ibm/granite-4-h-small


# Database URL (SQLite for development)
DATABASE_URL=sqlite:///./ruido.db